{
  "name": "Just One Family",
  "short_name": "Just One",
  "description": "Our family's apps, in one place.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f5f7",
  "theme_color": "#141821",
  "icons": [
    {
      "src": "/hub-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/hub-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "id": "/",
  "scope_extensions": [
    {
      "origin": "https://homefin.justonefamily.app"
    },
    {
      "origin": "https://*.justonefamily.app"
    }
  ]
}